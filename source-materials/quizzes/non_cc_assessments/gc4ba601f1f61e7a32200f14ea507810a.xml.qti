<?xml version="1.0" encoding="UTF-8"?>
<questestinterop xmlns="http://www.imsglobal.org/xsd/ims_qtiasiv1p2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.imsglobal.org/xsd/ims_qtiasiv1p2 http://www.imsglobal.org/xsd/ims_qtiasiv1p2p1.xsd">
  <assessment ident="gc4ba601f1f61e7a32200f14ea507810a" title="3.4 Practice Quiz: Consumer and Producer Surplus">
    <qtimetadata>
      <qtimetadatafield>
        <fieldlabel>cc_maxattempts</fieldlabel>
        <fieldentry>unlimited</fieldentry>
      </qtimetadatafield>
    </qtimetadata>
    <section ident="root_section">
      <item ident="ga8f3073c7f5dc6c19ee81292343aa000" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>text_only_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>0.0</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>original_answer_ids</fieldlabel>
              <fieldentry></fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>passage</fieldlabel>
              <fieldentry>true</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>assessment_question_identifierref</fieldlabel>
              <fieldentry>gf47b767d37e06559ff801f2d253307ba</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;
&lt;p&gt;Suppose that the supply and demand functions for the global market for copper are as follows:&lt;/p&gt;
&lt;p&gt;Q&lt;sub&gt;D&lt;/sub&gt; = 39 – 3P&lt;/p&gt;
&lt;p&gt;Q&lt;sub&gt;S&lt;/sub&gt; = 2P – 1&lt;/p&gt;
&lt;p&gt;where quantity is in millions of metric tons and price is in US dollars ($) per kilogram.&lt;/p&gt;
&lt;p&gt;&lt;br&gt;What is the market equilibrium price and quantity? Enter your answers separately below.&lt;/p&gt;
&lt;/div&gt;</mattext>
          </material>
        </presentation>
      </item>
      <item ident="g46618ef38db3f7eaa6fe188f7b183eaa" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>numerical_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1.0</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>original_answer_ids</fieldlabel>
              <fieldentry>62209</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>assessment_question_identifierref</fieldlabel>
              <fieldentry>gf47b767d37e06559ff801f2d253307ba</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;What is the market equilibrium price?&lt;/div&gt;</mattext>
          </material>
          <response_str ident="response1" rcardinality="Single">
            <render_fib fibtype="Decimal">
              <response_label ident="answer1"/>
            </render_fib>
          </response_str>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="Yes">
            <conditionvar>
              <other/>
            </conditionvar>
            <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
          </respcondition>
          <respcondition continue="No">
            <conditionvar>
              <or>
                <varequal respident="response1">8.0</varequal>
                <and>
                  <vargte respident="response1">8.0</vargte>
                  <varlte respident="response1">8.0</varlte>
                </and>
              </or>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
        <itemfeedback ident="general_fb">
          <flow_mat>
            <material>
              <mattext texttype="text/html">&lt;p&gt;Feedback: In equilibrium, quantity demanded should equal quantity supplied, that is, we should have:&lt;br&gt;Q&lt;sub&gt;D&lt;/sub&gt; = Q&lt;sub&gt;S&lt;/sub&gt;&lt;br&gt;39 – 3P = 2P – 1&lt;br&gt;5P = 40&lt;br&gt;P =&amp;nbsp; 8&lt;/p&gt;
&lt;p&gt;Note that price is in US dollars ($) per kilogram&lt;/p&gt;</mattext>
            </material>
          </flow_mat>
        </itemfeedback>
      </item>
      <item ident="g8ba3e2884f7da8d35176c8d3226551ad" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>numerical_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1.0</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>original_answer_ids</fieldlabel>
              <fieldentry>53514,68477</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>assessment_question_identifierref</fieldlabel>
              <fieldentry>gf47b767d37e06559ff801f2d253307ba</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;What is the market equilibrium quantity?&lt;/div&gt;</mattext>
          </material>
          <response_str ident="response1" rcardinality="Single">
            <render_fib fibtype="Decimal">
              <response_label ident="answer1"/>
            </render_fib>
          </response_str>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="Yes">
            <conditionvar>
              <other/>
            </conditionvar>
            <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
          </respcondition>
          <respcondition continue="No">
            <conditionvar>
              <or>
                <varequal respident="response1">15000000.0</varequal>
                <and>
                  <vargte respident="response1">15000000.0</vargte>
                  <varlte respident="response1">15000000.0</varlte>
                </and>
              </or>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
          <respcondition continue="No">
            <conditionvar>
              <or>
                <varequal respident="response1">15.0</varequal>
                <and>
                  <vargte respident="response1">15.0</vargte>
                  <varlte respident="response1">15.0</varlte>
                </and>
              </or>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
        <itemfeedback ident="general_fb">
          <flow_mat>
            <material>
              <mattext texttype="text/html">&lt;p&gt;Feedback: Plug the price of $8 per kilogram back in to either the demand or supply equation to find the equilibrium quantity:&lt;/p&gt;
&lt;p&gt;Q&lt;sub&gt;D&lt;/sub&gt; = 39 – 3*8 = 15&lt;/p&gt;
&lt;p&gt;OR&lt;/p&gt;
&lt;p&gt;Q&lt;sub&gt;S&lt;/sub&gt; = 2*8 – 1 = 15&lt;/p&gt;
&lt;p&gt;Since the units are in millions of metric tons, the equilibrium quantity is 15,000,000 tons. The practice quiz accepts either 15 (assuming the units are millions of metric tons) or 15,000,000 (assuming the units are tons).&lt;/p&gt;</mattext>
            </material>
          </flow_mat>
        </itemfeedback>
      </item>
      <item ident="g66c28dc09ab5003d208b189377ecae0d" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>numerical_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1.0</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>original_answer_ids</fieldlabel>
              <fieldentry>65873</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>assessment_question_identifierref</fieldlabel>
              <fieldentry>gf47b767d37e06559ff801f2d253307ba</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;
&lt;p&gt;For the graph below, calculate the consumer surplus.&lt;/p&gt;
&lt;p&gt;&lt;img src="$IMS-CC-FILEBASE$/Files%20for%20Microeconomics%20Summer%20Preparation/Q3Q2Q.png" alt="Q3Q2Q.png" width="600" height="366" loading="lazy"&gt;&lt;/p&gt;
&lt;/div&gt;</mattext>
          </material>
          <response_str ident="response1" rcardinality="Single">
            <render_fib fibtype="Decimal">
              <response_label ident="answer1"/>
            </render_fib>
          </response_str>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="Yes">
            <conditionvar>
              <other/>
            </conditionvar>
            <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
          </respcondition>
          <respcondition continue="No">
            <conditionvar>
              <or>
                <varequal respident="response1">2.0</varequal>
                <and>
                  <vargte respident="response1">2.0</vargte>
                  <varlte respident="response1">2.0</varlte>
                </and>
              </or>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
        <itemfeedback ident="general_fb">
          <flow_mat>
            <material>
              <mattext texttype="text/html">&lt;p&gt;Feedback: The consumer surplus is the area of the triangle below the demand curve and above the equilibrium price line. It is represented by the blue triangle in the graph below.&lt;/p&gt;
&lt;p&gt;&lt;img src="$IMS-CC-FILEBASE$/Files%20for%20Microeconomics%20Summer%20Preparation/Q3Q2F1.png" alt="Q3Q2F1.png" width="600" height="371" loading="lazy"&gt;&lt;br&gt;&amp;nbsp;&lt;br&gt;Remember, the area of a triangle is defined as follows: &lt;br&gt;AREA= 1/2 * base * height.&lt;br&gt;&amp;nbsp;&lt;br&gt;Thus, CS = 1/2 * 4 * 1 = 2.&lt;/p&gt;</mattext>
            </material>
          </flow_mat>
        </itemfeedback>
      </item>
      <item ident="gec6cffaf1c75bd1cd9fced5ea2c1fefa" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>numerical_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1.0</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>original_answer_ids</fieldlabel>
              <fieldentry>94965</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>assessment_question_identifierref</fieldlabel>
              <fieldentry>gf47b767d37e06559ff801f2d253307ba</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;
&lt;p&gt;For the same graph in the previous question, calculate the producer surplus.&lt;/p&gt;
&lt;p&gt;&lt;img src="$IMS-CC-FILEBASE$/Files%20for%20Microeconomics%20Summer%20Preparation/Q3Q2Q.png" alt="Q3Q2Q.png" width="600" height="366" loading="lazy"&gt;&lt;/p&gt;
&lt;/div&gt;</mattext>
          </material>
          <response_str ident="response1" rcardinality="Single">
            <render_fib fibtype="Decimal">
              <response_label ident="answer1"/>
            </render_fib>
          </response_str>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="Yes">
            <conditionvar>
              <other/>
            </conditionvar>
            <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
          </respcondition>
          <respcondition continue="No">
            <conditionvar>
              <or>
                <varequal respident="response1">4.0</varequal>
                <and>
                  <vargte respident="response1">4.0</vargte>
                  <varlte respident="response1">4.0</varlte>
                </and>
              </or>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
        <itemfeedback ident="general_fb">
          <flow_mat>
            <material>
              <mattext texttype="text/html">&lt;p&gt;Feedback: The producer surplus is the area of the triangle above the supply curve and below the equilibrium price line. It is represented by the blue triangle in the graph below.&lt;/p&gt;
&lt;p&gt;&lt;img src="$IMS-CC-FILEBASE$/Files%20for%20Microeconomics%20Summer%20Preparation/Q3Q2F2.png" alt="Q3Q2F2.png" width="600" height="366" loading="lazy"&gt;&amp;nbsp;&lt;/p&gt;
&lt;p&gt;Thus, PS = 1/2 * 4 * 2 = 4.&lt;/p&gt;</mattext>
            </material>
          </flow_mat>
        </itemfeedback>
      </item>
