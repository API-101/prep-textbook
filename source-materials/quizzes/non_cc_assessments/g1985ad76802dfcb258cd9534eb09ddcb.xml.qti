<?xml version="1.0"?>
<questestinterop xmlns="http://www.imsglobal.org/xsd/ims_qtiasiv1p2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.imsglobal.org/xsd/ims_qtiasiv1p2 http://www.imsglobal.org/xsd/ims_qtiasiv1p2p1.xsd">
  <assessment ident="g1985ad76802dfcb258cd9534eb09ddcb" title="1.5 Practice Quiz: Demand, Supply, and Equilibrium" external_assignment_id="959878">
    <qtimetadata>
      <qtimetadatafield>
        <fieldlabel>cc_maxattempts</fieldlabel>
        <fieldentry>unlimited</fieldentry>
      </qtimetadatafield>
    </qtimetadata>
    <section ident="root_section">
      <item ident="36ee9b956ed4bbc3df416dc3bb19ad19" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>numerical_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1.0</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>original_answer_ids</fieldlabel>
              <fieldentry>a5ed5c6b-f295-44a3-96f6-d1f3c3d4e4e2</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>assessment_question_identifierref</fieldlabel>
              <fieldentry>310a265c29caf3e8248e5f3c1fb85eea</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>calculator_type</fieldlabel>
              <fieldentry>none</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;
&lt;p&gt;&lt;span style="font-size: 14pt;"&gt;Suppose that the demand for a good is given by the equation Q&lt;sub&gt;D&lt;/sub&gt; = 8 &#x2013; 4P.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;
&lt;p&gt;&lt;span style="font-size: 14pt;"&gt;How many units are demanded at price 1?&lt;/span&gt;&lt;/p&gt;
&lt;/div&gt;</mattext>
          </material>
          <response_str ident="response1" rcardinality="Single">
            <render_fib fibtype="Decimal">
              <response_label ident="answer1"/>
            </render_fib>
          </response_str>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <or>
                <varequal respident="response1" precisiontype="significantDigits" precision="1">4.0</varequal>
                <and>
                  <vargt respident="response1">3.5</vargt>
                  <varlte respident="response1">4.5</varlte>
                </and>
              </or>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
        <itemfeedback ident="general_fb">
          <flow_mat>
            <material>
              <mattext texttype="text/html">&lt;p&gt;Feedback: You can solve this using algebra. Plug in the given price for P and solve the equation to find units demanded.&lt;/p&gt;
&lt;p&gt;Demand at price 1 is given by Q&lt;sub&gt;D&lt;/sub&gt; = 8 &#x2013; 4*1 = 4.&lt;/p&gt;</mattext>
            </material>
          </flow_mat>
        </itemfeedback>
      </item>
      <item ident="784f5d8abeae0138940335474c1541e0" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>numerical_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1.0</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>original_answer_ids</fieldlabel>
              <fieldentry>115c70fb-7b5c-4e79-bfe3-074335d5b4ae</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>assessment_question_identifierref</fieldlabel>
              <fieldentry>3006a2cab30a616ded5f7c5bf141df58</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>calculator_type</fieldlabel>
              <fieldentry>none</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;
&lt;p&gt;&lt;span style="font-size: 14pt;"&gt;Suppose that the supply for a good is given by the equation Q&lt;sub&gt;S&lt;/sub&gt; = 2P + 5.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;
&lt;p&gt;&lt;span style="font-size: 14pt;"&gt;How many units are supplied at price 2?&lt;/span&gt;&lt;/p&gt;
&lt;/div&gt;</mattext>
          </material>
          <response_str ident="response1" rcardinality="Single">
            <render_fib fibtype="Decimal">
              <response_label ident="answer1"/>
            </render_fib>
          </response_str>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <or>
                <varequal respident="response1" precisiontype="significantDigits" precision="1">9.0</varequal>
                <and>
                  <vargt respident="response1">8.5</vargt>
                  <varlte respident="response1">9.5</varlte>
                </and>
              </or>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
        <itemfeedback ident="general_fb">
          <flow_mat>
            <material>
              <mattext texttype="text/html">&lt;p&gt;Feedback: As with the previous question, you can solve this using algebra. Plug in the given price for P and solve the equation to find units supplied.&lt;/p&gt;
&lt;p&gt;Supply at price 2 is given by Q&lt;sub&gt;S&lt;/sub&gt; = 2*2 + 5 = 9.&amp;nbsp;&lt;/p&gt;</mattext>
            </material>
          </flow_mat>
        </itemfeedback>
      </item>
      <item ident="50174d64f795e61f2633b41241809776" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>multiple_choice_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1.0</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>original_answer_ids</fieldlabel>
              <fieldentry>48c4ac70-8479-46b2-8652-e78f9f0a8150,1a85257d-5066-46c0-88b1-d20c58be266d,f24b474f-3b3e-4135-8c02-1eb6906b8c54,b9c05cd7-66b7-4912-bf54-e4496010a4cb,5ea084dc-491f-451f-8cb8-b3b9a40b38ec</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>assessment_question_identifierref</fieldlabel>
              <fieldentry>5aa3023205cc7392050796f5e52bcd4e</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>calculator_type</fieldlabel>
              <fieldentry>none</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;span style="font-size: 14pt;"&gt;Suppose that consumers will buy 100 units of a good at price 10 and 50 units at price 20 and that the demand curve is linear. Find the equation for the demand curve so that price is a function of quantity.&lt;/span&gt;&lt;/div&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="48c4ac70-8479-46b2-8652-e78f9f0a8150">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;span style="font-size: 14pt;"&gt;&amp;nbsp;P = 150 &#x2013; 5Q&lt;sub&gt;D&lt;/sub&gt;&lt;/span&gt;&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="1a85257d-5066-46c0-88b1-d20c58be266d">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;span style="font-size: 14pt;"&gt;P = 30 + Q&lt;sub&gt;D&lt;/sub&gt;/5&lt;/span&gt;&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="f24b474f-3b3e-4135-8c02-1eb6906b8c54">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;span style="font-size: 14pt;"&gt;P = 30 &#x2013; Q&lt;sub&gt;D&lt;/sub&gt;/5&lt;/span&gt;&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="b9c05cd7-66b7-4912-bf54-e4496010a4cb">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;span style="font-size: 14pt;"&gt;P = Q&lt;sub&gt;D&lt;/sub&gt;/5 - 10&lt;/span&gt;&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="5ea084dc-491f-451f-8cb8-b3b9a40b38ec">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;span style="font-size: 14pt;"&gt;P = -Q&lt;sub&gt;D&lt;/sub&gt;/5&lt;/span&gt;&lt;/p&gt;</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">f24b474f-3b3e-4135-8c02-1eb6906b8c54</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
        <itemfeedback ident="general_fb">
          <flow_mat>
            <material>
              <mattext texttype="text/html">Feedback: The slope of the demand curve is given by the ratio:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; Change in Price / Change in Quantity.&lt;br&gt;&amp;nbsp;&amp;nbsp; &amp;nbsp;&lt;br&gt;Starting with price 10 and quantity 100, a change in price to 20 causes a reduction in quantity demanded to 50. This represents a change in price of 20 &#x2013; 10 = 10 and a change in quantity of 50 &#x2013; 100 = -50, so the demand curve has slope of 10/-50 = -1/5.&lt;br&gt;&amp;nbsp;&amp;nbsp; &amp;nbsp;&lt;br&gt;Since the demand curve is linear, it can be represented in the form:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; P&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; =&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; Intercept &#x2013; Slope * Q&lt;sub&gt;D&lt;/sub&gt; &lt;br&gt;&amp;nbsp;&amp;nbsp; &amp;nbsp;&lt;br&gt;Since we know slope equals -1/5, it can be simplified in the form:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; P&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; =&amp;nbsp;&amp;nbsp;&amp;nbsp; Intercept &#x2013; (1/5)*Q&lt;sub&gt;D&lt;/sub&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &amp;nbsp;&lt;br&gt;&amp;nbsp;&amp;nbsp; &amp;nbsp;&lt;br&gt;To solve for the Intercept in this equation, substitute either of the known pairs of values (P = 10, Q = 100) or (P = 20, Q = 50):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; 20&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; =&amp;nbsp;&amp;nbsp;&amp;nbsp; Intercept &#x2013; 1/5*50&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; 20&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; =&amp;nbsp;&amp;nbsp;&amp;nbsp; Intercept &#x2013; 10&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; Intercept&amp;nbsp;&amp;nbsp;&amp;nbsp; =&amp;nbsp;&amp;nbsp;&amp;nbsp; 30&lt;br&gt;&amp;nbsp;&amp;nbsp; &amp;nbsp;&lt;br&gt;That is, the demand function is given by the linear equation P = 30 &#x2013; (1/5)*Q&lt;sub&gt;D&lt;/sub&gt;.</mattext>
            </material>
          </flow_mat>
        </itemfeedback>
      </item>
      <item ident="075b8af3a2990a5cf228bc70fb333654" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>multiple_choice_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1.0</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>original_answer_ids</fieldlabel>
              <fieldentry>f790af75-504a-4f4a-bf07-2939982e4255,c5c906df-07d2-42bb-8b7a-183dcbf20f56,b9cb1d48-4dfc-41ac-84a0-305b41294b2d,dc49a872-8fa5-4bd6-8401-3dcd05416cad,8f052d19-8c48-4926-8719-7e0834df073a</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>assessment_question_identifierref</fieldlabel>
              <fieldentry>a2485a688bcc402b7aa4810dcafaa5b3</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>calculator_type</fieldlabel>
              <fieldentry>none</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;
&lt;p&gt;&lt;span style="font-size: 14pt;"&gt;A demand function is given by the linear equation Q&lt;sub&gt;D&lt;/sub&gt; = 150 &#x2013; 5P.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;
&lt;p&gt;&lt;span style="font-size: 14pt;"&gt;Invert and graph the equation. Which graph matches your equation?&lt;/span&gt;&lt;/p&gt;
&lt;/div&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="f790af75-504a-4f4a-bf07-2939982e4255">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;img src="$IMS-CC-FILEBASE$/Uploaded Media/Q1Q4AA.png" alt="Q1Q4AA.png" width="600" data-old-link="/courses/148972/files/20310061/preview?verifier=zxFKmOO9Cq2U6CO00r8uE3o1PEDLK6VvJFH0Ku0v" loading="lazy"&gt;&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="c5c906df-07d2-42bb-8b7a-183dcbf20f56">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;img src="$IMS-CC-FILEBASE$/Uploaded Media/Q1Q4AB.png" alt="Q1Q4AB.png" width="600" data-old-link="/courses/148972/files/20310073/preview?verifier=plmvyHSTZCMv91kb9L36qfG4T8YjRMLxihm1lrRx" loading="lazy"&gt;&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="b9cb1d48-4dfc-41ac-84a0-305b41294b2d">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;img src="$IMS-CC-FILEBASE$/Uploaded Media/Q1Q4AC.png" alt="Q1Q4AC.png" width="600" data-old-link="/courses/148972/files/20310050/preview?verifier=ch5wq9XPku8L7XtDCvcJkYczjmoATPxEwL4P3vhT" loading="lazy"&gt;&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="dc49a872-8fa5-4bd6-8401-3dcd05416cad">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;img src="$IMS-CC-FILEBASE$/Uploaded Media/Q1Q4AD.png" alt="Q1Q4AD.png" width="600" data-old-link="/courses/148972/files/20310074/preview?verifier=a4JYdHWWDPcu4f4vhexotV5hzf15c0x4C4N17QXq" loading="lazy"&gt;&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="8f052d19-8c48-4926-8719-7e0834df073a">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;img src="$IMS-CC-FILEBASE$/Uploaded Media/Q1Q4AE.png" alt="Q1Q4AE.png" width="600" data-old-link="/courses/148972/files/20310065/preview?verifier=LjltVvEAE4o3ckTO10x7rjtP4NKK72ew4wrWo5Gh" loading="lazy"&gt;&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">8f052d19-8c48-4926-8719-7e0834df073a</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
        <itemfeedback ident="general_fb">
          <flow_mat>
            <material>
              <mattext texttype="text/html">&lt;p&gt;Feedback: Since the convention in microeconomics is to produce graphs with quantity on the horizontal axis and price on the vertical axis, we have to invert this equation to make price a function of quantity in order to graph it in the standard format.&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;
&lt;p&gt;Since Q = 150 &#x2013; 5P, we know 5P = 150 &#x2013; Q, or P = 30 &#x2013; Q/5. So this is the function that we will use to graph the demand curve.&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;
&lt;p&gt;We can identify the correct graph by finding at least two points. Two easy points are the two intercepts. When P = 0, Q = 150. When Q = 0, P = 30.&lt;/p&gt;
&lt;p&gt;&lt;img src="$IMS-CC-FILEBASE$/Uploaded Media/Q1Q4AE.png" alt="Q1Q4AE.png" width="600" data-old-link="/courses/148972/files/20310065/preview?verifier=LjltVvEAE4o3ckTO10x7rjtP4NKK72ew4wrWo5Gh" loading="lazy"&gt;&lt;/p&gt;</mattext>
            </material>
          </flow_mat>
        </itemfeedback>
      </item>
      <item ident="90daf22158d31cb2ab7042daa84ac849" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>multiple_choice_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1.0</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>original_answer_ids</fieldlabel>
              <fieldentry>b278c9b2-8eb8-479e-afa8-70e812b0088b,b8050a4f-130f-4b48-bf5f-f24073bbe33f,eb06cbcd-fac2-4347-852d-c484cefd802a,dd7e4bb4-0dc9-4956-bdc7-22e5ae35d1f8,fc63c150-66f0-4421-ba87-788ce5bb8ce4</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>assessment_question_identifierref</fieldlabel>
              <fieldentry>79b633176db327abf474bc19c8b1cdc2</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>calculator_type</fieldlabel>
              <fieldentry>none</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;span style="font-size: 14pt;"&gt;Suppose that producers will supply 4 units at price 2 and that the supply curve is linear and that for each increase of 1 unit in price, the quantity supplied increases by 4 units. Find the equation for the supply curve so that price is a function of quantity.&lt;/span&gt;&lt;/div&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="b278c9b2-8eb8-479e-afa8-70e812b0088b">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;span style="font-size: 14pt;"&gt;P = 4Q&lt;sub&gt;S&lt;/sub&gt; &#x2013; 4&lt;/span&gt;&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="b8050a4f-130f-4b48-bf5f-f24073bbe33f">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;span style="font-size: 14pt;"&gt;P = 4Q&lt;sub&gt;S&lt;/sub&gt; &#x2013; 14&lt;/span&gt;&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="eb06cbcd-fac2-4347-852d-c484cefd802a">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;span style="font-size: 14pt;"&gt;P = Q&lt;sub&gt;S&lt;/sub&gt;/4&lt;/span&gt;&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="dd7e4bb4-0dc9-4956-bdc7-22e5ae35d1f8">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;span style="font-size: 14pt;"&gt;P = Q&lt;sub&gt;S&lt;/sub&gt;/4 + 1&lt;/span&gt;&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="fc63c150-66f0-4421-ba87-788ce5bb8ce4">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;span style="font-size: 14pt;"&gt;P = Q&lt;sub&gt;S&lt;/sub&gt;/4 + 3.5&lt;/span&gt;&lt;/p&gt;</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">dd7e4bb4-0dc9-4956-bdc7-22e5ae35d1f8</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
        <itemfeedback ident="general_fb">
          <flow_mat>
            <material>
              <mattext texttype="text/html">Feedback: The equation for the supply curve can be represented in the following form:&lt;br&gt;&amp;nbsp;Price = Intercept + Slope * Quantity.&lt;br&gt;&amp;nbsp;&lt;br&gt;&lt;br&gt;We know that when the price increases by 1 the quantity supplied increases by 4 units, so the slope is 1/4. To solve for the intercept, substitute the known values (Q = 4, P = 2) and slope = 1/4:&lt;br&gt;&lt;br&gt;2&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; =&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; Intercept + (1/4)*4&lt;br&gt;&lt;br&gt;2&amp;nbsp; - 1&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; =&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; Intercept&lt;br&gt;&lt;br&gt;Intercept&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; =&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; 1&lt;br&gt;&lt;br&gt;So the supply function can be represented as P = 1 + Q&lt;sub&gt;S&lt;/sub&gt;/4</mattext>
            </material>
          </flow_mat>
        </itemfeedback>
      </item>
      <item ident="8d60271a70281f9a3c2352be32169a41" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>multiple_choice_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1.0</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>original_answer_ids</fieldlabel>
              <fieldentry>ba321d47-a786-4641-ba0c-7f4454e6f6fa,d9ffbc6a-d3aa-45e2-a66a-d2f017bc4d5c,558ab603-84dc-478f-a5ec-72ad29409971,cb5204f3-e421-4891-8ad2-ac6626f1d481,27bd4291-7ee8-4fa6-8d9e-617733b38ac7</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>assessment_question_identifierref</fieldlabel>
              <fieldentry>f8ddc56754fd9f978e20b73e574379cb</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>calculator_type</fieldlabel>
              <fieldentry>none</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;span style="font-size: 14pt;"&gt;Graph your supply curve from Question #5. Which graph matches yours?&lt;/span&gt;&lt;/div&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="ba321d47-a786-4641-ba0c-7f4454e6f6fa">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;img src="$IMS-CC-FILEBASE$/Uploaded Media/Q1Q6AA.png" alt="Q1Q6AA.png" width="600" data-old-link="/courses/148972/files/20310066/preview?verifier=dRFh2AoXiucODfeAKgBhq5PG2PBKEPMrYX11tYrk" loading="lazy"&gt;&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="d9ffbc6a-d3aa-45e2-a66a-d2f017bc4d5c">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;img src="$IMS-CC-FILEBASE$/Uploaded Media/Q1Q6AB.png" alt="Q1Q6AB.png" width="600" data-old-link="/courses/148972/files/20310060/preview?verifier=rxs5ejsefw69y0o5svCwjLqN6cniKpsYfCAJHLFO" loading="lazy"&gt;&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="558ab603-84dc-478f-a5ec-72ad29409971">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;img src="$IMS-CC-FILEBASE$/Uploaded Media/Q1Q6AC.png" alt="Q1Q6AC.png" width="600" data-old-link="/courses/148972/files/20310063/preview?verifier=XcayKPNkW6WysX7b5LSBXWdPe0z4yJdR5Zi3K1v2" loading="lazy"&gt;&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="cb5204f3-e421-4891-8ad2-ac6626f1d481">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;img src="$IMS-CC-FILEBASE$/Uploaded Media/Q1Q6AD.png" alt="Q1Q6AD.png" width="600" data-old-link="/courses/148972/files/20310051/preview?verifier=iqmOyoOOncPvrl9mZ7VJ7IcufBaB50cQB4faSPPx" loading="lazy"&gt;&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="27bd4291-7ee8-4fa6-8d9e-617733b38ac7">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;img src="$IMS-CC-FILEBASE$/Uploaded Media/Q1Q6AE.png" alt="Q1Q6AE.png" width="600" data-old-link="/courses/148972/files/20310062/preview?verifier=0ar4c9MQlBgIQbggQVe8i59JFH95zU8ODixMheV3" loading="lazy"&gt;&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">ba321d47-a786-4641-ba0c-7f4454e6f6fa</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
        <itemfeedback ident="general_fb">
          <flow_mat>
            <material>
              <mattext texttype="text/html">&lt;p&gt;Feedback: To graph the function Q&lt;sub&gt;S&lt;/sub&gt; = 4P &#x2013; 4 with quantity on the x-axis and price on the y-axis, we need to first invert the relationship to make price a function of quantity:&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; Q = 4P &#x2013; 4&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; 4P = Q + 4&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; P = 1 + Q/4.&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/p&gt;
&lt;p&gt;This equation gives a negative value for supply at price &amp;lt; 1, so we interpret this to mean that supply equals 0 for any price less than 1.&amp;nbsp;&lt;/p&gt;
&lt;p&gt;We know that the y-intercept must be 1, and Option A is the only option that has a y-intercept of 1.&lt;/p&gt;
&lt;p&gt;&lt;img src="$IMS-CC-FILEBASE$/Uploaded Media/Q1Q6AA.png" alt="Q1Q6AA.png" width="600" data-old-link="/courses/148972/files/20310066/preview?verifier=dRFh2AoXiucODfeAKgBhq5PG2PBKEPMrYX11tYrk" loading="lazy"&gt;&lt;/p&gt;</mattext>
            </material>
          </flow_mat>
        </itemfeedback>
      </item>
      <item ident="29560f5d2d8f924d1d516ecdfb511393" title="Question" instructions="">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>text_only_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1.0</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>original_answer_ids</fieldlabel>
              <fieldentry/>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>assessment_question_identifierref</fieldlabel>
              <fieldentry>42583d31abb9d67ad09634e3a0b0a5af</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>calculator_type</fieldlabel>
              <fieldentry>none</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>source_url</fieldlabel>
              <fieldentry/>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>passage</fieldlabel>
              <fieldentry>false</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material orientation="left">
            <mattext texttype="text/html">&lt;div&gt;
&lt;p&gt;&lt;span style="font-size: 14pt;"&gt;Consider the following:&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;
&lt;p&gt;&lt;span style="font-size: 14pt;"&gt;The demand curve is given by the equation:&lt;/span&gt;&lt;br&gt;&lt;span style="font-size: 14pt;"&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; Q&lt;sub&gt;D&lt;/sub&gt; = 8 &#x2013; 4P&lt;/span&gt;&lt;br&gt;&lt;span style="font-size: 14pt;"&gt;&amp;nbsp;&amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;br&gt;&lt;span style="font-size: 14pt;"&gt;The supply curve is given by the equation:&lt;/span&gt;&lt;br&gt;&lt;span style="font-size: 14pt;"&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; Q&lt;sub&gt;S&lt;/sub&gt; = 2P + 5&lt;/span&gt;&lt;br&gt;&lt;span style="font-size: 14pt;"&gt;&amp;nbsp;&amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;br&gt;&lt;span style="font-size: 14pt;"&gt;What is the market equilibrium price and quantity? Enter your answers separately below.&lt;/span&gt;&lt;/p&gt;
&lt;/div&gt;</mattext>
          </material>
        </presentation>
      </item>
      <item ident="44bc78ed10f72364a586129e818240e4" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>numerical_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1.0</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>original_answer_ids</fieldlabel>
              <fieldentry>fb021364-cebe-45a7-885e-301b319ef379</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>assessment_question_identifierref</fieldlabel>
              <fieldentry>55c45aebbfddbb636c511f8c4161dc68</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>parent_stimulus_item_ident</fieldlabel>
              <fieldentry>29560f5d2d8f924d1d516ecdfb511393</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>calculator_type</fieldlabel>
              <fieldentry>none</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;span style="font-size: 14pt;"&gt;What is the market equilibrium price?&lt;/span&gt;&lt;/div&gt;</mattext>
          </material>
          <response_str ident="response1" rcardinality="Single">
            <render_fib fibtype="Decimal">
              <response_label ident="answer1"/>
            </render_fib>
          </response_str>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <or>
                <varequal respident="response1" precisiontype="significantDigits" precision="1">0.5</varequal>
                <and>
                  <vargt respident="response1">0.45</vargt>
                  <varlte respident="response1">0.55</varlte>
                </and>
              </or>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
        <itemfeedback ident="general_fb">
          <flow_mat>
            <material>
              <mattext texttype="text/html">&lt;p&gt;Feedback: Set the two equations equal to each other in order to find where the supply and demand curves intersect:&lt;/p&gt;
&lt;p&gt;8 &#x2013; 4P = 2P + 5&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;
&lt;p&gt;Solve for P.&lt;/p&gt;
&lt;p&gt;8 &#x2013; 4P = 2P + 5&lt;/p&gt;
&lt;p&gt;8 &#x2013; 5 = 2P + 4P&lt;/p&gt;
&lt;p&gt;3 = 6P&lt;/p&gt;
&lt;p&gt;P = 0.5&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;
&lt;p&gt;At the market equilibrium, price = 0.5&lt;/p&gt;</mattext>
            </material>
          </flow_mat>
        </itemfeedback>
      </item>
      <item ident="54508d511e91a9bdcc36eb06be09cbae" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>numerical_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1.0</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>original_answer_ids</fieldlabel>
              <fieldentry>c6c08828-68cc-4b1a-8fb7-6d8a51dd993e</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>assessment_question_identifierref</fieldlabel>
              <fieldentry>f2841994faf150dcaabf00a8350d976f</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>parent_stimulus_item_ident</fieldlabel>
              <fieldentry>29560f5d2d8f924d1d516ecdfb511393</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>calculator_type</fieldlabel>
              <fieldentry>none</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;span style="font-size: 14pt;"&gt;What is the market equilibrium quantity?&lt;/span&gt;&lt;/div&gt;</mattext>
          </material>
          <response_str ident="response1" rcardinality="Single">
            <render_fib fibtype="Decimal">
              <response_label ident="answer1"/>
            </render_fib>
          </response_str>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <or>
                <varequal respident="response1" precisiontype="significantDigits" precision="1">6.0</varequal>
                <and>
                  <vargt respident="response1">5.5</vargt>
                  <varlte respident="response1">6.5</varlte>
                </and>
              </or>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
        <itemfeedback ident="general_fb">
          <flow_mat>
            <material>
              <mattext texttype="text/html">&lt;p&gt;Feedback: Solve for P (you did this in the previous question).&amp;nbsp; Then plug the value P = 0.5 into either the demand or supply curve to find the equilibrium.&lt;/p&gt;
&lt;p&gt;Q&lt;sub&gt;D&lt;/sub&gt; = 8 &#x2013; 4P&lt;/p&gt;
&lt;p&gt;Q&lt;sub&gt;D&lt;/sub&gt; = 8 &#x2013; 4*0.5&lt;/p&gt;
&lt;p&gt;Q&lt;sub&gt;D&lt;/sub&gt; = 6&lt;/p&gt;
&lt;p&gt;OR&lt;/p&gt;
&lt;p&gt;Q&lt;sub&gt;S&lt;/sub&gt; = 2P + 5&lt;/p&gt;
&lt;p&gt;Q&lt;sub&gt;S&lt;/sub&gt; = 2*0.5 + 5&lt;/p&gt;
&lt;p&gt;Q&lt;sub&gt;S&lt;/sub&gt; = 6&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;
&lt;p&gt;At the market equilibrium, quantity = 6.&lt;/p&gt;</mattext>
            </material>
          </flow_mat>
        </itemfeedback>
      </item>
    </section>
  </assessment>
</questestinterop>
