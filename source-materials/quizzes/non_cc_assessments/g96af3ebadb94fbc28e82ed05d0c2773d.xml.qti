            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;Note that Canvas automatically formats numerical inputs, adding four decimal places.&amp;nbsp; For example, a response of "1" will appear as "1.0000".&amp;nbsp; Please disregard this unnecessary format change.&lt;/div&gt;</mattext>
          </material>
        </presentation>
      </item>
      <item ident="g5920b150e81eb62475f486a23d52bb37" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>numerical_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1.0</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>original_answer_ids</fieldlabel>
              <fieldentry>3162</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>assessment_question_identifierref</fieldlabel>
              <fieldentry>gf47b767d37e06559ff801f2d253307ba</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;
&lt;p&gt;Suppose that the demand for a good is given by the equation Q&lt;sub&gt;D&lt;/sub&gt; = 8 – 4P.&lt;/p&gt;
&lt;p&gt;How many units are demanded at price 1?&lt;/p&gt;
&lt;/div&gt;</mattext>
          </material>
          <response_str ident="response1" rcardinality="Single">
            <render_fib fibtype="Decimal">
              <response_label ident="answer1"/>
            </render_fib>
          </response_str>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="Yes">
            <conditionvar>
              <other/>
            </conditionvar>
            <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
          </respcondition>
          <respcondition continue="No">
            <conditionvar>
              <or>
                <varequal respident="response1">4.0</varequal>
                <and>
                  <vargte respident="response1">4.0</vargte>
                  <varlte respident="response1">4.0</varlte>
                </and>
              </or>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
        <itemfeedback ident="general_fb">
          <flow_mat>
            <material>
              <mattext texttype="text/html">&lt;p&gt;Feedback: You can solve this using algebra. Plug in the given price for P and solve the equation to find units demanded.&lt;/p&gt;
&lt;p&gt;Demand at price 1 is given by Q&lt;sub&gt;D&lt;/sub&gt; = 8 – 4*1 = 4.&lt;/p&gt;</mattext>
            </material>
          </flow_mat>
        </itemfeedback>
      </item>
      <item ident="g58ead8ba3f400efdf16a07471c538c45" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>numerical_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1.0</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>original_answer_ids</fieldlabel>
              <fieldentry>47585</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>assessment_question_identifierref</fieldlabel>
              <fieldentry>gf47b767d37e06559ff801f2d253307ba</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;
&lt;p&gt;Suppose that the supply for a good is given by the equation Q&lt;sub&gt;S&lt;/sub&gt; = 2P + 5.&lt;/p&gt;
&lt;p&gt;How many units are supplied at price 2?&lt;/p&gt;
&lt;/div&gt;</mattext>
          </material>
          <response_str ident="response1" rcardinality="Single">
            <render_fib fibtype="Decimal">
              <response_label ident="answer1"/>
            </render_fib>
          </response_str>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="Yes">
            <conditionvar>
              <other/>
            </conditionvar>
            <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
          </respcondition>
          <respcondition continue="No">
            <conditionvar>
              <or>
                <varequal respident="response1">9.0</varequal>
                <and>
                  <vargte respident="response1">9.0</vargte>
                  <varlte respident="response1">9.0</varlte>
                </and>
              </or>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
        <itemfeedback ident="general_fb">
          <flow_mat>
            <material>
              <mattext texttype="text/html">&lt;p&gt;Feedback: As with the previous question, you can solve this using algebra. Plug in the given price for P and solve the equation to find units supplied.&lt;/p&gt;
&lt;p&gt;Supply at price 2 is given by Q&lt;sub&gt;S&lt;/sub&gt; = 2*2 + 5 = 9.&amp;nbsp;&lt;/p&gt;</mattext>
            </material>
          </flow_mat>
        </itemfeedback>
      </item>
      <item ident="g2769b9e91b8d4fcb9aa1e0a5b3b655a9" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>multiple_choice_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1.0</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>original_answer_ids</fieldlabel>
              <fieldentry>39560,5443,75105,21734,8701</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>assessment_question_identifierref</fieldlabel>
              <fieldentry>gf47b767d37e06559ff801f2d253307ba</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;Suppose that consumers will buy 100 units of a good at price 10 and 50 units at price 20 and that the demand curve is linear. Find the equation for the demand curve so that price is a function of quantity.&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="39560">
                <material>
                  <mattext texttype="text/html">&amp;nbsp;P = 150 – 5Q&lt;sub&gt;D&lt;/sub&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="5443">
                <material>
                  <mattext texttype="text/html">P = 30 + Q&lt;sub&gt;D&lt;/sub&gt;/5</mattext>
                </material>
              </response_label>
              <response_label ident="75105">
                <material>
                  <mattext texttype="text/html">P = 30 – Q&lt;sub&gt;D&lt;/sub&gt;/5</mattext>
                </material>
              </response_label>
              <response_label ident="21734">
                <material>
                  <mattext texttype="text/html">P = Q&lt;sub&gt;D&lt;/sub&gt;/5 - 10</mattext>
                </material>
              </response_label>
              <response_label ident="8701">
                <material>
                  <mattext texttype="text/html">P = -Q&lt;sub&gt;D&lt;/sub&gt;/5</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="Yes">
            <conditionvar>
              <other/>
            </conditionvar>
            <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
          </respcondition>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">75105</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
        <itemfeedback ident="general_fb">
          <flow_mat>
            <material>
              <mattext texttype="text/html">Feedback: The slope of the demand curve is given by the ratio:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; Change in Price / Change in Quantity.&lt;br&gt;&amp;nbsp;&amp;nbsp; &amp;nbsp;&lt;br&gt;Starting with price 10 and quantity 100, a change in price to 20 causes a reduction in quantity demanded to 50. This represents a change in price of 20 – 10 = 10 and a change in quantity of 50 – 100 = -50, so the demand curve has slope of 10/-50 = -1/5.&lt;br&gt;&amp;nbsp;&amp;nbsp; &amp;nbsp;&lt;br&gt;Since the demand curve is linear, it can be represented in the form:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; P&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; =&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; Intercept – Slope * Q&lt;sub&gt;D&lt;/sub&gt; &lt;br&gt;&amp;nbsp;&amp;nbsp; &amp;nbsp;&lt;br&gt;Since we know slope equals -1/5, it can be simplified in the form:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; P&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; =&amp;nbsp;&amp;nbsp;&amp;nbsp; Intercept – (1/5)*Q&lt;sub&gt;D&lt;/sub&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &amp;nbsp;&lt;br&gt;&amp;nbsp;&amp;nbsp; &amp;nbsp;&lt;br&gt;To solve for the Intercept in this equation, substitute either of the known pairs of values (P = 10, Q = 100) or (P = 20, Q = 50):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; 20&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; =&amp;nbsp;&amp;nbsp;&amp;nbsp; Intercept – 1/5*50&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; 20&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; =&amp;nbsp;&amp;nbsp;&amp;nbsp; Intercept – 10&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; Intercept&amp;nbsp;&amp;nbsp;&amp;nbsp; =&amp;nbsp;&amp;nbsp;&amp;nbsp; 30&lt;br&gt;&amp;nbsp;&amp;nbsp; &amp;nbsp;&lt;br&gt;That is, the demand function is given by the linear equation P = 30 – (1/5)*Q&lt;sub&gt;D&lt;/sub&gt;.</mattext>
            </material>
          </flow_mat>
        </itemfeedback>
      </item>
      <item ident="gfb43e8adb403e5295c6ab12552d1c128" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>multiple_choice_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1.0</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>original_answer_ids</fieldlabel>
              <fieldentry>15936,46881,44693,7430,23747</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>assessment_question_identifierref</fieldlabel>
              <fieldentry>gf47b767d37e06559ff801f2d253307ba</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;
&lt;p&gt;A demand function is given by the linear equation Q&lt;sub&gt;D&lt;/sub&gt; = 150 – 5P.&lt;/p&gt;
&lt;p&gt;Invert and graph the equation. Which graph matches your equation?&lt;/p&gt;
&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="15936">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;img src="$IMS-CC-FILEBASE$/Files%20for%20Microeconomics%20Summer%20Preparation/Q1Q4AA.png" alt="Q1Q4AA.png" width="600" loading="lazy"&gt;&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="46881">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;img src="$IMS-CC-FILEBASE$/Files%20for%20Microeconomics%20Summer%20Preparation/Q1Q4AB.png" alt="Q1Q4AB.png" width="600" loading="lazy"&gt;&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="44693">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;img src="$IMS-CC-FILEBASE$/Files%20for%20Microeconomics%20Summer%20Preparation/Q1Q4AC.png" alt="Q1Q4AC.png" width="600" loading="lazy"&gt;&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="7430">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;img src="$IMS-CC-FILEBASE$/Files%20for%20Microeconomics%20Summer%20Preparation/Q1Q4AD.png" alt="Q1Q4AD.png" width="600" loading="lazy"&gt;&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="23747">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;img src="$IMS-CC-FILEBASE$/Files%20for%20Microeconomics%20Summer%20Preparation/Q1Q4AE.png" alt="Q1Q4AE.png" width="600" loading="lazy"&gt;&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="Yes">
            <conditionvar>
              <other/>
            </conditionvar>
            <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
          </respcondition>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">23747</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
        <itemfeedback ident="general_fb">
          <flow_mat>
            <material>
              <mattext texttype="text/html">&lt;p&gt;Feedback: Since the convention in microeconomics is to produce graphs with quantity on the horizontal axis and price on the vertical axis, we have to invert this equation to make price a function of quantity in order to graph it in the standard format.&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;
&lt;p&gt;Since Q = 150 – 5P, we know 5P = 150 – Q, or P = 30 – Q/5. So this is the function that we will use to graph the demand curve.&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;
&lt;p&gt;We can identify the correct graph by finding at least two points. Two easy points are the two intercepts. When P = 0, Q = 150. When Q = 0, P = 30.&lt;/p&gt;
&lt;p&gt;&lt;img src="$IMS-CC-FILEBASE$/Files%20for%20Microeconomics%20Summer%20Preparation/Q1Q4AE.png" alt="Q1Q4AE.png" width="600" loading="lazy"&gt;&lt;/p&gt;</mattext>
            </material>
          </flow_mat>
        </itemfeedback>
      </item>
      <item ident="g498c987c9cc899ee09dadfe78821b384" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>multiple_choice_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1.0</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>original_answer_ids</fieldlabel>
              <fieldentry>14176,44618,54559,97055,89418</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>assessment_question_identifierref</fieldlabel>
              <fieldentry>gf47b767d37e06559ff801f2d253307ba</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;Suppose that producers will supply 4 units at price 2 and that the supply curve is linear and that for each increase of 1 unit in price, the quantity supplied increases by 4 units. Find the equation for the supply curve so that price is a function of quantity.&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="14176">
                <material>
                  <mattext texttype="text/html">P = 4Q&lt;sub&gt;S&lt;/sub&gt; – 4</mattext>
                </material>
              </response_label>
              <response_label ident="44618">
                <material>
                  <mattext texttype="text/html">P = 4Q&lt;sub&gt;S&lt;/sub&gt; – 14</mattext>
                </material>
              </response_label>
              <response_label ident="54559">
                <material>
                  <mattext texttype="text/html">P = Q&lt;sub&gt;S&lt;/sub&gt;/4</mattext>
                </material>
              </response_label>
              <response_label ident="97055">
                <material>
                  <mattext texttype="text/html">P = Q&lt;sub&gt;S&lt;/sub&gt;/4 + 1</mattext>
                </material>
              </response_label>
              <response_label ident="89418">
                <material>
                  <mattext texttype="text/html">P = Q&lt;sub&gt;S&lt;/sub&gt;/4 + 3.5</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="Yes">
            <conditionvar>
              <other/>
            </conditionvar>
            <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
          </respcondition>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">97055</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
        <itemfeedback ident="general_fb">
          <flow_mat>
            <material>
              <mattext texttype="text/html">Feedback: The equation for the supply curve can be represented in the following form:&lt;br&gt;&amp;nbsp;Price = Intercept + Slope * Quantity.&lt;br&gt;&amp;nbsp;&lt;br&gt;&lt;br&gt;We know that when the price increases by 1 the quantity supplied increases by 4 units, so the slope is 1/4. To solve for the intercept, substitute the known values (Q = 4, P = 2) and slope = 1/4:&lt;br&gt;&lt;br&gt;2&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; =&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; Intercept + (1/4)*4&lt;br&gt;&lt;br&gt;2&amp;nbsp; - 1&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; =&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; Intercept&lt;br&gt;&lt;br&gt;Intercept&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; =&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; 1&lt;br&gt;&lt;br&gt;So the supply function can be represented as P = 1 + Q&lt;sub&gt;S&lt;/sub&gt;/4</mattext>
            </material>
          </flow_mat>
        </itemfeedback>
      </item>
      <item ident="ge64e8372a2628ba66470319976a99fbb" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>multiple_choice_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1.0</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>original_answer_ids</fieldlabel>
              <fieldentry>77684,23779,32765,22775,22817</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>assessment_question_identifierref</fieldlabel>
              <fieldentry>gf47b767d37e06559ff801f2d253307ba</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;Graph your supply curve from Question #5. Which graph matches yours?&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="77684">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;img src="$IMS-CC-FILEBASE$/Files%20for%20Microeconomics%20Summer%20Preparation/Q1Q6AA.png" alt="Q1Q6AA.png" width="600" loading="lazy"&gt;&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="23779">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;img src="$IMS-CC-FILEBASE$/Files%20for%20Microeconomics%20Summer%20Preparation/Q1Q6AB.png" alt="Q1Q6AB.png" width="600" loading="lazy"&gt;&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="32765">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;img src="$IMS-CC-FILEBASE$/Files%20for%20Microeconomics%20Summer%20Preparation/Q1Q6AC.png" alt="Q1Q6AC.png" width="600" loading="lazy"&gt;&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="22775">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;img src="$IMS-CC-FILEBASE$/Files%20for%20Microeconomics%20Summer%20Preparation/Q1Q6AD.png" alt="Q1Q6AD.png" width="600" loading="lazy"&gt;&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="22817">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;img src="$IMS-CC-FILEBASE$/Files%20for%20Microeconomics%20Summer%20Preparation/Q1Q6AE.png" alt="Q1Q6AE.png" width="600" loading="lazy"&gt;&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="Yes">
            <conditionvar>
              <other/>
            </conditionvar>
            <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
          </respcondition>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">77684</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
        <itemfeedback ident="general_fb">
          <flow_mat>
            <material>
              <mattext texttype="text/html">&lt;p&gt;Feedback: To graph the function Q&lt;sub&gt;S&lt;/sub&gt; = 4P – 4 with quantity on the x-axis and price on the y-axis, we need to first invert the relationship to make price a function of quantity:&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; Q = 4P – 4&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; 4P = Q + 4&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; P = 1 + Q/4.&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/p&gt;
&lt;p&gt;This equation gives a negative value for supply at price &amp;lt; 1, so we interpret this to mean that supply equals 0 for any price less than 1.&amp;nbsp;&lt;/p&gt;
&lt;p&gt;We know that the y-intercept must be 1, and Option A is the only option that has a y-intercept of 1.&lt;/p&gt;
&lt;p&gt;&lt;img src="$IMS-CC-FILEBASE$/Files%20for%20Microeconomics%20Summer%20Preparation/Q1Q6AA.png" alt="Q1Q6AA.png" width="600" loading="lazy"&gt;&lt;/p&gt;</mattext>
            </material>
          </flow_mat>
        </itemfeedback>
      </item>
      <item ident="g2baf728f1a95e103732afbbd0aaffb3e" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>text_only_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>0.0</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>original_answer_ids</fieldlabel>
              <fieldentry></fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>passage</fieldlabel>
              <fieldentry>true</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>assessment_question_identifierref</fieldlabel>
              <fieldentry>gf47b767d37e06559ff801f2d253307ba</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;
&lt;p&gt;Consider the following:&lt;/p&gt;
&lt;p&gt;The demand curve is given by the equation:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; Q&lt;sub&gt;D&lt;/sub&gt; = 8 – 4P&lt;br&gt;&amp;nbsp;&amp;nbsp; &amp;nbsp;&lt;br&gt;The supply curve is given by the equation:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; Q&lt;sub&gt;S&lt;/sub&gt; = 2P + 5&lt;br&gt;&amp;nbsp;&amp;nbsp; &amp;nbsp;&lt;br&gt;What is the market equilibrium price and quantity? Enter your answers separately below.&lt;/p&gt;
&lt;/div&gt;</mattext>
          </material>
        </presentation>
      </item>
      <item ident="g2ab1499edfdaf332d4d01d53fb40176b" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>numerical_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1.0</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>original_answer_ids</fieldlabel>
              <fieldentry>92867</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>assessment_question_identifierref</fieldlabel>
              <fieldentry>gf47b767d37e06559ff801f2d253307ba</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;What is the market equilibrium price?&lt;/div&gt;</mattext>
          </material>
          <response_str ident="response1" rcardinality="Single">
            <render_fib fibtype="Decimal">
              <response_label ident="answer1"/>
            </render_fib>
          </response_str>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="Yes">
            <conditionvar>
              <other/>
            </conditionvar>
            <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
          </respcondition>
          <respcondition continue="No">
            <conditionvar>
              <or>
                <varequal respident="response1">0.5</varequal>
                <and>
                  <vargte respident="response1">0.5</vargte>
                  <varlte respident="response1">0.5</varlte>
                </and>
              </or>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
        <itemfeedback ident="general_fb">
          <flow_mat>
            <material>
              <mattext texttype="text/html">&lt;p&gt;Feedback: Set the two equations equal to each other in order to find where the supply and demand curves intersect:&lt;/p&gt;
&lt;p&gt;8 – 4P = 2P + 5&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;
&lt;p&gt;Solve for P.&lt;/p&gt;
&lt;p&gt;8 – 4P = 2P + 5&lt;/p&gt;
&lt;p&gt;8 – 5 = 2P + 4P&lt;/p&gt;
&lt;p&gt;3 = 6P&lt;/p&gt;
&lt;p&gt;P = 0.5&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;
&lt;p&gt;At the market equilibrium, price = 0.5&lt;/p&gt;</mattext>
            </material>
          </flow_mat>
        </itemfeedback>
      </item>
      <item ident="g17c7dee295681a28fe0b09b0240838b7" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>numerical_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1.0</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>original_answer_ids</fieldlabel>
              <fieldentry>74307</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>assessment_question_identifierref</fieldlabel>
              <fieldentry>gf47b767d37e06559ff801f2d253307ba</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;What is the market equilibrium quantity?&lt;/div&gt;</mattext>
          </material>
          <response_str ident="response1" rcardinality="Single">
            <render_fib fibtype="Decimal">
              <response_label ident="answer1"/>
            </render_fib>
          </response_str>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="Yes">
            <conditionvar>
              <other/>
            </conditionvar>
            <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
          </respcondition>
          <respcondition continue="No">
            <conditionvar>
              <or>
                <varequal respident="response1">6.0</varequal>
                <and>
                  <vargte respident="response1">6.0</vargte>
                  <varlte respident="response1">6.0</varlte>
                </and>
              </or>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
        <itemfeedback ident="general_fb">
          <flow_mat>
            <material>
              <mattext texttype="text/html">&lt;p&gt;Feedback: Solve for P (you did this in the previous question).&amp;nbsp; Then plug the value P = 0.5 into either the demand or supply curve to find the equilibrium.&lt;/p&gt;
&lt;p&gt;Q&lt;sub&gt;D&lt;/sub&gt; = 8 – 4P&lt;/p&gt;
&lt;p&gt;Q&lt;sub&gt;D&lt;/sub&gt; = 8 – 4*0.5&lt;/p&gt;
&lt;p&gt;Q&lt;sub&gt;D&lt;/sub&gt; = 6&lt;/p&gt;
&lt;p&gt;OR&lt;/p&gt;
&lt;p&gt;Q&lt;sub&gt;S&lt;/sub&gt; = 2P + 5&lt;/p&gt;
&lt;p&gt;Q&lt;sub&gt;S&lt;/sub&gt; = 2*0.5 + 5&lt;/p&gt;
&lt;p&gt;Q&lt;sub&gt;S&lt;/sub&gt; = 6&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;
&lt;p&gt;At the market equilibrium, quantity = 6.&lt;/p&gt;</mattext>
            </material>
          </flow_mat>
        </itemfeedback>
      </item>
