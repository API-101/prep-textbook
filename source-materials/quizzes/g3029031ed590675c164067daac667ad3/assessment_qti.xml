              <response_label ident="80407">
                <material>
                  <mattext texttype="text/plain">Demand curve shifts out.</mattext>
                </material>
              </response_label>
              <response_label ident="43873">
                <material>
                  <mattext texttype="text/plain">Supply curve shifts in.</mattext>
                </material>
              </response_label>
              <response_label ident="73218">
                <material>
                  <mattext texttype="text/plain">Supply curve shifts out.</mattext>
                </material>
              </response_label>
              <response_label ident="70877">
                <material>
                  <mattext texttype="text/plain">No shift.</mattext>
                </material>
              </response_label>
